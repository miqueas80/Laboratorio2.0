diff --git a/index.html b/index.html
index 762a9b4..62a0652 100644
--- a/index.html
+++ b/index.html
@@ -1,6 +1,7 @@
 <!doctype html>
 <html lang="es">
 <head>
+<meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'; form-action 'none'">
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
 <meta name="theme-color" content="#0b5268">
@@ -25,6 +26,11 @@
 .voice-status{display:flex;align-items:center;gap:8px;padding:9px 11px;border-radius:8px;background:#f2f7f8;font-size:12px}.voice-status.active{background:#e4f6f2;color:#146b61}.voice-status .pulse{width:9px;height:9px;border-radius:50%;background:#9aa;display:inline-block}.voice-status.active .pulse{background:#2fa87d;box-shadow:0 0 0 5px #2fa87d22;animation:nexusPulse 1.3s infinite}@keyframes nexusPulse{50%{transform:scale(1.35);opacity:.6}}
 .voice-transcript{min-height:54px;margin-top:9px;padding:9px;border:1px solid var(--line);border-radius:8px;background:#fff;font-size:12px}
 @media(max-width:850px){.advanced-tools{grid-template-columns:1fr}}
+/* Ajustes de acceso y viewport; se conserva la composición original. */
