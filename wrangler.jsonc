{
  "name": "nexus-xkiro-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "NEXUS_ALLOWED_ORIGINS": "https://miqueas80.github.io"
  },
  "ratelimits": [
    {
      "name": "NEXUS_RATE_LIMITER",
      "namespace_id": "20261001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
